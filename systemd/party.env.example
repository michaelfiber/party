# Default env for the party systemd units.
# Copied to /etc/party.env by scripts/install-systemd-units.sh
# Integration keys match .env.example — leave a pair blank to hide that cloud in the UI.

# Runtime
# PARTY_ENV=production
PARTY_ADDR=:3066
PARTY_PUBLIC_BASE_URL=https://cubeofb.org/party

# Google Drive
PARTY_GOOGLE_CLIENT_ID=
PARTY_GOOGLE_CLIENT_SECRET=

# Dropbox
PARTY_DROPBOX_APP_KEY=
PARTY_DROPBOX_APP_SECRET=

# Microsoft OneDrive (Azure App registration: Web platform, not SPA)
# Copy the client secret Value, not the Secret ID. Quote it if it contains #.
PARTY_MICROSOFT_CLIENT_ID=
PARTY_MICROSOFT_CLIENT_SECRET=

# Twilio (copied from /etc/photobooth.env by the install script)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# PARTY_DEBUG_LOGIN_SMS=7326701359

# SSH reverse tunnel
PARTY_SSH_REMOTE=cubeofb.org
PARTY_PORT=3066
PARTY_REMOTE_PORT=3066
